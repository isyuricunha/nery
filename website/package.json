{
  "name": "nery-mizuki-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "node --test scripts/test-animation-timing.mjs scripts/test-i18n.mjs scripts/test-contrast.mjs",
    "test:seo": "node --test scripts/test-seo.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "astro dev",
    "lint": "node scripts/prepare-assets.mjs && eslint .",
    "check": "node scripts/prepare-assets.mjs && astro check",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/geist": "latest",
    "astro": "7.4.12",
    "lucide-static": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-plugin-astro": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "globals": "latest",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "latest"
  }
}
