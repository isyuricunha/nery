---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages, type Locale } from '../i18n/messages';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const c = messages[locale];
import arrow from 'lucide-static/icons/arrow-up-right.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
const repo = 'https://github.com/isyuricunha/nery';
const expressions = c.expressions;
const poses = [['portrait',745,905],['happy',222,198],['thinking',214,197],['coding',225,218],['coffee',225,222],['sleeping',312,228],['with-cat',294,198],['fullbody',195,403]] as const;
const states = c.states;
---
<BaseLayout locale={locale}>
<header class="header wrap"><a class="brand" href="#main" aria-label={c.home}><span class="brand-mark">N<span> / </span>M</span><span>Nery Mizuki</span></a><nav aria-label={c.navigation}><a href="#identity">{c.identity}</a><a href="#kit">{c.kit}</a><a href="#pet">{c.pet} <span class="live-dot"></span></a><a href="#usage">{c.usage}</a></nav><div class="language-switch" aria-label={c.language}><a href="/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a><a href="/pt-br" lang="pt-BR" hreflang="pt-BR" aria-current={locale === 'pt-br' ? 'page' : undefined}>PT-BR</a></div><a class="source-link" href={repo}>{c.repository} <span class="icon" set:html={arrow} /></a></header>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="line"></span> {c.eyebrow}</p><h1 id="hero-title">Nery<br />Mizuki<span class="period">.</span></h1><p class="tagline">{c.yuri} <span class="yu-shimmer-gold">{c.mascot}</span></p><p class="hero-description">{c.intro}<br class="desktop" /> {c.introEnd}</p><div class="actions"><a class="button primary" href="#pet">{c.hello} <span class="icon" set:html={sparkles} /></a><a class="button" href="#kit">{c.explore} <span class="icon" set:html={arrow} /></a></div><a class="credit" href="#license">© 2026 Yuri Cunha · {c.rights}</a></div><div class="hero-art"><div class="orbit"></div><img src="/kit/nery-portrait.webp" alt={c.portraitAlt} width="745" height="905" fetchpriority="high" /><span class="art-note"><span class="live-dot"></span> {c.artNote}</span><span class="art-index">{c.characterFile}</span></div></section>
<div class="intro-strip"><div class="wrap"><span>{c.curious}</span><span>{c.warm}</span><span>{c.always}</span><span class="small-gold">{c.officialHome}</span></div></div>
<section id="identity" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{c.identityNumber}</p><h2>{c.identityTitle}<br />{c.family}</h2></div><p>{c.identityDescription}</p></div><div class="identity-grid"><article class="card look"><p class="overline">{c.canonical}</p><h3>{c.copper}<br />{c.warmth}</h3><p>{c.appearance}</p><p>{c.style}</p><div class="swatches">{[['#211915','Charcoal'],['#2A211D','Warm'],['#CC785C','Terracotta'],['#F0E9E3','Cream'],['#B9A195','Muted']].map(([color,label])=><span style={`--swatch:${color}`}>{c.palette[label as keyof typeof c.palette]}<small>{color}</small></span>)}</div></article><article class="card"><p class="overline">{c.keepTrue}</p><h3>{c.neverTitle}</h3><ul class="rules"><li>{c.ruleHair}</li><li>{c.rulePurple}</li><li>{c.ruleRobot}</li><li>{c.ruleLogo}</li><li>{c.ruleRedraw}</li><li>{c.ruleLicense}</li></ul></article></div><div class="expression"><div><p class="overline">{c.expression}</p><h3>{c.feeling}<br />{c.moments}</h3><p>{c.expressionDescription}</p></div><div class="table-wrap"><table><caption class="sr-only">{c.expressionGuide}</caption><thead><tr><th scope="col">{c.context}</th><th scope="col">{c.suggestion}</th></tr></thead><tbody>{expressions.map(([context,expression])=><tr><td>{context}</td><td>{expression}</td></tr>)}</tbody></table></div></div></section>
<section id="kit" class="section kit-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{c.kitNumber}</p><h2>{c.kitTitle}</h2></div><p>{c.kitDescription}<br />{c.kitDescriptionEnd}</p></div><div class="gallery">{poses.map(([file,width,height],i)=><figure class="pose"><div class="pose-image"><img src={`/kit/nery-${file}.webp`} alt={`Nery Mizuki — ${c.poses[i]}`} width={width} height={height} loading="lazy" style={`max-width:min(100%, ${width}px)`} /></div><figcaption><span>{c.poses[i]}</span><small>0{i+1}</small></figcaption></figure>)}</div><div class="kit-note"><span class="overline">{c.kitVersion}</span><p>{c.originalArtwork} <strong>195 × 403 px.</strong></p></div></div></section>
<section id="pet" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{c.petNumber}</p><h2>{c.petTitle}</h2></div><p>{c.petDescription}</p></div><div class="pet-panel"><div class="panel-top"><span><span class="live-dot"></span> {c.petPanel}</span><span>PETDEX / SPRITE V2</span></div><div class="pet-stage"><span class="stage-label">{c.stage}</span><button class="pet-hit" id="preview-hit" aria-label={c.hello}><canvas id="pet-preview" width="192" height="208" role="img" aria-label={c.previewAlt}>{c.canvasFallback}</canvas></button><div class="speech-bubble" id="preview-speech" hidden><p role="status" aria-live="polite" aria-atomic="true"></p><button type="button" class="speech-close" aria-label={c.dismiss}>×</button></div><span class="stage-ground"></span><p id="pet-state" aria-live="polite">{c.states[0]}</p></div><div class="pet-controls" aria-label={c.petControls}>{states.map((state,i)=><button type="button" data-state={i} aria-pressed={i===0}>{state}</button>)}</div><div class="speech-tools"><button id="speech-toggle" type="button" aria-pressed="true">{c.speechOn}</button><button id="speech-another" type="button">{c.saySomething}</button></div><div class="panel-bottom"><span>{c.stateCount}</span><span>{c.world}</span></div></div><p class="pet-hint">{c.petHint} <span>{c.reduced}</span></p><noscript><p>{c.noScript}</p></noscript></section>
<section id="usage" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{c.usageNumber}</p><h2>{c.usageTitle}<br />{c.usageTitleEnd}</h2></div><p>{c.usageDescription}</p></div><div class="usage-grid"><article><span class="step">01</span><h3>{c.sourceTitle}</h3><p>{c.sourceText} <a href={`${repo}/releases`}>{c.release}</a> {c.sourceEnd}</p></article><article><span class="step">02</span><h3>{c.versionTitle}</h3><p>{c.versionText}</p></article><article><span class="step">03</span><h3>{c.surfaceTitle}</h3><p>{c.surfaceText} <a href={`${repo}/blob/main/docs/IDENTITY.md`}>{c.identityRules}</a>{c.surfaceEnd}</p></article><article><span class="step">04</span><h3>{c.artTitle}</h3><p>{c.artText} <a href="#license">{c.license}</a>.</p></article></div></section>
<section id="license" class="wrap license-section"><div class="license-card"><div><p class="eyebrow">{c.licenseNumber}</p><h2>{c.identityTitle}<br />{c.artwork}</h2><a class="button" href={`${repo}/blob/main/assets/mascot/LICENSE.md`}>{c.fullLicense} <span class="icon" set:html={arrow} /></a></div><div><p>{c.proprietary} <strong>© 2026 Yuri Cunha. {c.rights}.</strong></p><p>{c.licenseText}</p><p>{c.thirdParties}</p><p class="license-emphasis">{c.licenseSeparation}</p></div></div></section>
</main>
<footer class="wrap footer"><a class="brand" href="#main"><span class="brand-mark">N<span> / </span>M</span><span>Nery Mizuki<small>{c.footerMascot}</small></span></a><div class="footer-links"><a href={repo}>GitHub ↗</a><a href="https://gitlab.com/isyuricunha/nery">GitLab ↗</a><a href="https://git.yuricunha.com/isyuricunha/nery">YuGit ↗</a></div><a class="credit" href="#license">© 2026 Yuri Cunha. {c.rights}.</a></footer>
<div class="walker-shell"><div class="speech-bubble" id="walker-speech" hidden><p role="status" aria-live="polite" aria-atomic="true"></p><button type="button" class="speech-close" aria-label={c.dismiss}>×</button></div><button id="walker-hit" aria-label={c.walkerHello}><canvas id="pet-walker" width="96" height="104" role="img" aria-label={c.walkerAlt}>{c.walkerFallback}</canvas></button></div>
<script>import '../scripts/pet';
for (const link of document.querySelectorAll<HTMLAnchorElement>('.language-switch a')) {
  link.addEventListener('click', () => { link.hash = window.location.hash; });
}
</script>
</BaseLayout>
