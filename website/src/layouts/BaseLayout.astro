---
import '../styles/yutheme-kit.css';
import '../styles/global.css';
const title = 'Nery Mizuki — Yuri Cunha’s mascot.';
const description = 'Nery Mizuki is Yuri Cunha’s personal mascot, created for his projects, products and websites, including Mnerys. Meet her and explore her approved artwork.';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ''), Astro.site).href.replace(/\/$/, '');
const image = new URL('/og.png', Astro.site).href;
const graph = {'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':`${canonical}/#website`,url:canonical,name:'Nery Mizuki',description,inLanguage:'en'},{'@type':'WebPage',url:canonical,name:title,isPartOf:{'@id':`${canonical}/#website`},description},{'@type':'Person',name:'Yuri Cunha',url:'https://yuricunha.com'}]};
---
<!doctype html><html lang="en" data-theme="yu-amoled"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><meta name="robots" content="index,follow,max-image-preview:large" /><meta name="color-scheme" content="dark" /><meta name="referrer" content="strict-origin-when-cross-origin" /><meta name="theme-color" content="#000000" />
<link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<meta property="og:type" content="website" /><meta property="og:site_name" content="Nery Mizuki" /><meta property="og:locale" content="en_US" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={image} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Nery Mizuki, Yuri Cunha’s copper-haired mascot." />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} /><meta name="twitter:image:alt" content="Nery Mizuki, Yuri Cunha’s copper-haired mascot." /><script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head><body><a class="skip" href="#main">Skip to content</a><slot /></body></html>
