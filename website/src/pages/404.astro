---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages } from '../i18n/messages';
const c = messages.en;
const pt = messages['pt-br'];
---
<BaseLayout notFound>
  <main id="main" tabindex="-1" class="error-page wrap">
    <p class="eyebrow">404 / NERY MIZUKI</p>
    <h1>{c.notFoundTitle}</h1><p>{c.notFoundText}</p><a class="button primary" href="/">{c.returnHome}</a>
    <div lang="pt-BR"><h2>{pt.notFoundTitle}</h2><p>{pt.notFoundText}</p><a class="text-link" href="/pt-br">{pt.returnHome} <span aria-hidden="true">→</span></a></div>
  </main>
</BaseLayout>
